{
  "name": "fristenrechner-schweiz",
  "version": "0.6.0",
  "private": true,
  "description": "Hostneutraler Rechenkern und MVP-Oberfläche des Fristenrechners Schweiz",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23.0.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-standard-tests.mjs product",
    "test:core:ap12b": "node --import tsx --test tests/core/calendar-rules.test.ts",
    "build:data:ap17c:candidate": "node scripts/build-ap17c-candidate.mjs",
    "build:data:ap18c:candidate": "node scripts/build-ap18c-candidate.mjs",
    "build:data:ap19c:candidate": "node --import tsx scripts/build-ap19c-candidate.mjs",
    "build:data:ap19c2:candidate": "node --import tsx scripts/build-ap19c2-candidate.mjs",
    "build:data:ap19c3:candidate": "node --import tsx scripts/build-ap19c3-candidate.mjs",
    "build:data:ap20c1:candidate": "node --import tsx scripts/build-ap20c1-candidate.mjs",
    "test:ap20c1": "node --import tsx --test tests/core/ap20c1-*.test.ts tests/ui/ap20c1-*.test.ts",
    "test:ap20c1:spfx": "node scripts/check-ap19c-spfx-build.mjs --ap20c1",
    "build:data:ap20c2:candidate": "node --import tsx scripts/build-ap20c2-candidate.mjs",
    "test:ap20c2": "node --import tsx --test tests/core/ap20c2-*.test.ts tests/ui/ap20c2-*.test.ts",
    "test:ap20c2:spfx": "node scripts/check-ap19c-spfx-build.mjs --ap20c2",
    "build:data:ap20c3:candidate": "node --import tsx scripts/build-ap20c3-candidate.mjs",
    "test:ap20c3": "node --import tsx --test tests/core/ap20c3-*.test.ts tests/ui/ap20c3-*.test.ts",
    "test:ap20c3:spfx": "node scripts/check-ap19c-spfx-build.mjs --ap20c3",
    "test:ap19c3": "node --import tsx --test tests/core/ap19c3-*.test.ts tests/ui/ap19c3-social.test.ts && .venv/bin/python tests/data/test_ap19c3_contract.py",
    "test:ap19c2": "node --import tsx --test tests/core/ap19c2-*.test.ts tests/ui/ap19c2-social.test.ts && .venv/bin/python tests/data/test_ap19c2_contract.py",
    "test:ap19c": "node --import tsx --test tests/core/ap19c-*.test.ts tests/ui/ap19c-social.test.ts && .venv/bin/python tests/data/test_ap19c_contract.py",
    "test:ap19c:spfx": "node scripts/check-ap19c-spfx-build.mjs",
    "prepare:release:mvp06": "node scripts/prepare-mvp06-inputs.mjs",
    "check:sources:mvp06": "node scripts/consolidate-mvp06-sources.mjs",
    "check:source-approval:mvp06": "node scripts/verify-mvp06-source-approval.mjs",
    "check:integrity:mvp06": "node scripts/verify-mvp06-public-integrity.mjs",
    "test:source-reviews:private:mvp06": "node scripts/verify-mvp06-source-approval.mjs && node scripts/run-standard-tests.mjs private-mvp06 && .venv/bin/python tests/data/validate_mvp06_release.py data/releases/2026-10-01-mvp-06-approved.1",
    "build:data:mvp06": "node --import tsx scripts/promote-ap20-release.mjs",
    "test:data:mvp06": "node scripts/verify-mvp06-public-integrity.mjs && .venv/bin/python tests/data/validate_mvp06_release.py data/releases/2026-10-01-mvp-06-approved.1 --public-integrity",
    "build:spfx:mvp06": "node scripts/build-mvp06-spfx.mjs",
    "build:artifacts:mvp06": ".venv/bin/python scripts/prepare_mvp06_artifacts.py",
    "test:artifacts:mvp06": ".venv/bin/python -m unittest discover -s tests/data -p test_mvp06_artifacts.py",
    "test:artifacts:git:mvp06": ".venv/bin/python tests/private/mvp06_mirror_git_audit.py",
    "prepare:release:mvp05": "node scripts/prepare-mvp05-inputs.mjs",
    "test:release:mvp05": "node --test tests/governance/mvp05-preparation.test.mjs",
    "check:sources:mvp05": "node scripts/consolidate-mvp05-sources.mjs",
    "check:source-approval:mvp05": "node scripts/verify-mvp05-source-approval.mjs",
    "build:source-reviews:mvp05": "node scripts/prepare-mvp05-source-reviews.mjs && npm run build:source-reviews",
    "build:data:mvp05": "node --import tsx scripts/promote-ap19-release.mjs",
    "test:data:mvp05": ".venv/bin/python tests/data/validate_mvp05_release.py data/releases/2026-09-28-mvp-05-approved.1",
    "build:spfx:mvp05": "node scripts/build-mvp05-spfx.mjs",
    "build:artifacts:mvp05": ".venv/bin/python scripts/prepare_mvp05_artifacts.py",
    "test:artifacts:mvp05": ".venv/bin/python -m unittest discover -s tests/data -p test_mvp05_artifacts.py",
    "build:public:ap19c3": "FRISTENRECHNER_DATA_CANDIDATE=ap19c3 node scripts/build-public-app.mjs",
    "build:data:ap18c:release": "node --import tsx scripts/build-ap18c-release.mjs",
    "build:data:mvp04": "node --import tsx scripts/promote-ap18c-release.mjs",
    "test:data:mvp04": ".venv/bin/python tests/data/validate_release.py data/releases/2026-09-22-mvp-04-approved.1 --self-test",
    "build:public:ap18c": "FRISTENRECHNER_DATA_CANDIDATE=ap18c node scripts/build-public-app.mjs",
    "test:data:ap18c": ".venv/bin/python tests/data/validate_release.py data/releases/2026-09-22-ap18c-candidate.1 --self-test",
    "test:data:ap18c:contracts": ".venv/bin/python -m unittest discover -s tests/data -p 'test_*contract.py'",
    "test:ap18c:release": "node --import tsx --test tests/core/holiday-catalog.test.ts tests/core/ap18c-integration.test.ts tests/calendar-rules/ap18c-release.test.mjs tests/ui/ap18c-preview.test.ts",
    "test:ap18c": "node --test tests/calendar-rules/ap18c-import.test.mjs && python3 -m unittest discover -s tests/calendar-rules -p test_ap18c_reader.py",
    "test:archive:ap18": "node scripts/ap18-workbook-archive.mjs --check && node --test tests/archive/ap18-workbook-archive.test.mjs",
    "test:publication:ap18": "python3 scripts/ap18_publication_workbooks.py check && python3 -m unittest discover -s tests/archive -p 'test_*.py'",
    "test:calendar-models": "node --import tsx --test tests/calendar-rules/*.test.mjs",
    "test:ap17c": "node --import tsx --test tests/core/ap17c-qualified.test.ts tests/ui/ap17c-qualified.test.ts",
    "build:data:ap11b:candidate": "node scripts/build-ap11b-candidate.mjs",
    "build:data:ap11b:approved": "node scripts/promote-ap11b-release.mjs",
    "build:data:ap11b": "npm run build:data:ap11b:candidate && npm run build:data:ap11b:approved",
    "test:data:ap11b": ".venv/bin/python tests/data/validate_release.py data/releases/2026-08-30-ap11b-approved.1 --self-test && .venv/bin/python tests/special-regimes/validate_special_regime_release.py",
    "build:data:ap11c:candidate": "node scripts/build-ap11c-candidate.mjs",
    "build:data:ap11c:approved": "node scripts/promote-ap11c-release.mjs",
    "build:data:ap11c": "npm run build:data:ap11c:candidate && npm run build:data:ap11c:approved",
    "test:data:ap11c": ".venv/bin/python tests/data/validate_release.py data/releases/2026-08-30-ap11c-candidate.1 --self-test && .venv/bin/python tests/data/validate_release.py data/releases/2026-08-31-mvp-02-approved.1 --self-test && .venv/bin/python tests/data/validate_ap11c_release.py data/releases/2026-08-30-ap11c-candidate.1 && .venv/bin/python tests/data/validate_ap11c_release.py data/releases/2026-08-31-mvp-02-approved.1",
    "test:data:ap12a": ".venv/bin/python tests/calendar-rules/validate_ap12a_candidates.py",
    "build:data:ap12c:candidate": "node scripts/build-ap12c-candidate.mjs",
    "build:data:ap12c:approved": "node scripts/promote-ap12c-release.mjs",
    "build:data:ap12c": "npm run build:data:ap12c:candidate && npm run build:data:ap12c:approved",
    "test:data:ap12c": ".venv/bin/python tests/data/validate_release.py data/releases/2026-08-31-ap12c-candidate.1 --self-test && .venv/bin/python tests/data/validate_release.py data/releases/2026-08-31-mvp-03-approved.1 --self-test && .venv/bin/python tests/data/validate_ap12c_release.py data/releases/2026-08-31-ap12c-candidate.1 && .venv/bin/python tests/data/validate_ap12c_release.py data/releases/2026-08-31-mvp-03-approved.1",
    "build:source-reviews": "node scripts/build-source-review-index.mjs",
    "test:source-reviews": ".venv/bin/python tests/governance/validate_source_reviews.py --self-test && .venv/bin/python -m unittest discover -s tests/governance -p 'test_*.py' && node scripts/run-standard-tests.mjs governance",
    "build:source-reviews:mvp04": "node scripts/prepare-mvp04-source-reviews.mjs && npm run build:source-reviews",
    "check:sources:mvp04": "node scripts/consolidate-mvp04-source-checks.mjs",
    "check:source-approval:mvp04": "node scripts/verify-mvp04-source-approval.mjs",
    "build:artifacts:mvp04": ".venv/bin/python scripts/prepare_mvp04_artifacts.py",
    "test:artifacts:mvp04": ".venv/bin/python -m unittest discover -s tests/data -p test_mvp04_artifacts.py",
    "build:artifacts:mvp04:spfx-correction": ".venv/bin/python scripts/prepare_mvp04_spfx_correction.py",
    "test:artifacts:mvp04:spfx-correction": ".venv/bin/python -m unittest discover -s tests/data -p test_mvp04_spfx_correction.py",
    "build:ui": "node scripts/build-ui-preview.mjs",
    "preview:ui": "node scripts/ui-preview-server.mjs",
    "build:public": "node scripts/build-public-app.mjs",
    "preview:public": "node scripts/public-app-server.mjs",
    "test:public": "node --import tsx --test tests/public-app/*.test.ts",
    "check": "npm run typecheck && npm run test && npm run test:public && npm run build:ui && npm run build:public",
    "test:oracle": "python3 tests/golden/validate_golden_cases.py"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@fluentui/react": "8.106.4",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "tslib": "2.3.1"
  }
}
