{
  "name": "fristenrechner-schweiz-spfx",
  "version": "0.2.0",
  "private": true,
  "description": "SPFx-WebPart des Fristenrechners Schweiz für SharePoint und Microsoft Teams",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.14.0 < 23.0.0"
  },
  "scripts": {
    "sync": "node scripts/sync-schemas.mjs && node scripts/sync-product-source.mjs",
    "verify:github": "npm run sync && node --import tsx scripts/verify-github-provider.ts",
    "pretest": "npm run sync",
    "test": "node --import tsx --test test/*.test.ts",
    "audit:bundle": "node scripts/audit-product-css.mjs",
    "prebuild": "npm run sync",
    "build": "npm test && heft test --clean --production && npm run audit:bundle && heft package-solution --production",
    "clean": "heft clean",
    "eject-webpack": "heft eject-webpack",
    "prestart": "npm run sync",
    "start": "heft start --clean"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "tslib": "2.3.1",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "@fluentui/react": "8.106.4",
    "@microsoft/sp-core-library": "1.23.2",
    "@microsoft/sp-component-base": "1.23.2",
    "@microsoft/sp-property-pane": "1.23.2",
    "@microsoft/sp-webpart-base": "1.23.2",
    "@microsoft/sp-lodash-subset": "1.23.2",
    "@microsoft/sp-office-ui-fabric-core": "1.23.2",
    "@microsoft/sp-http": "1.23.2"
  },
  "devDependencies": {
    "@microsoft/eslint-plugin-spfx": "1.23.2",
    "@microsoft/eslint-config-spfx": "1.23.2",
    "@microsoft/spfx-web-build-rig": "1.23.2",
    "@microsoft/spfx-heft-plugins": "1.23.2",
    "@rushstack/heft": "1.2.17",
    "@types/jest": "30.0.0",
    "@types/webpack-env": "~1.15.2",
    "css-loader": "~7.1.2",
    "eslint": "9.37.0",
    "typescript": "~5.8.0",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "eslint-plugin-react-hooks": "5.2.0",
    "fake-indexeddb": "6.2.5",
    "tsx": "4.23.12",
    "@microsoft/sp-module-interfaces": "1.23.2"
  },
  "overrides": {
    "@rushstack/heft": "1.2.17"
  },
  "resolutions": {
    "@types/react": "17.0.45"
  }
}
