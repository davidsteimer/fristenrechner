{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/davidsteimer/fristenrechner/main/schemas/source-register.schema.json",
  "title": "Quellenregister des Fristenrechners Schweiz",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "formatVersion",
    "dataKind",
    "registerId",
    "registerStatus",
    "createdOn",
    "responsible",
    "scope",
    "sources"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/davidsteimer/fristenrechner/main/schemas/source-register.schema.json"
    },
    "formatVersion": {
      "const": "1.0.0"
    },
    "dataKind": {
      "const": "sourceRegister"
    },
    "registerId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "registerStatus": {
      "enum": ["candidate", "approved", "withdrawn"]
    },
    "createdOn": {
      "$ref": "common.schema.json#/$defs/isoDate"
    },
    "responsible": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jurisdictions", "productiveReleaseIds"],
      "properties": {
        "jurisdictions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(CH|[A-Z]{2})$"
          }
        },
        "productiveReleaseIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*\\.[0-9]+$"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "usageStatus",
        "sourceType",
        "title",
        "authority",
        "jurisdiction",
        "officialLocator",
        "officialUrl",
        "retrievalUrl",
        "documentVersionDate",
        "subjectAreas",
        "relevantProvisions"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^(SRC|JUD)-[A-Z0-9-]+$"
        },
        "usageStatus": {
          "enum": ["productive", "supporting", "monitoring"]
        },
        "sourceType": {
          "enum": [
            "statute",
            "ordinance",
            "caseLaw",
            "officialDossier",
            "officialMaterials",
            "officialDecision"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "authority": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "jurisdiction": {
          "type": "string",
          "pattern": "^(CH|[A-Z]{2})$"
        },
        "officialLocator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "officialUrl": {
          "oneOf": [
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrievalUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "documentVersionDate": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/isoDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "subjectAreas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "delivery",
              "deadlineStart",
              "deadlineCounting",
              "deadlineEnd",
              "deadlineSuspension",
              "publicHolidays",
              "specialRegimes",
              "amendmentMonitoring"
            ]
          }
        },
        "relevantProvisions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    }
  }
}
