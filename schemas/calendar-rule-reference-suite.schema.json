{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/davidsteimer/fristenrechner/main/schemas/calendar-rule-reference-suite.schema.json",
  "title": "Referenzvertrag für regelbasierte Kalender des Fristenrechners Schweiz",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "formatVersion",
    "dataKind",
    "suiteId",
    "status",
    "sourceReleaseId",
    "review",
    "legacyParityCases",
    "algorithmCases",
    "leapYearCases",
    "overrideCases",
    "failureCases"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/davidsteimer/fristenrechner/main/schemas/calendar-rule-reference-suite.schema.json"
    },
    "formatVersion": { "const": "1.0.0" },
    "dataKind": { "const": "calendarRuleReferenceSuite" },
    "suiteId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "status": { "enum": ["candidate", "approved"] },
    "sourceReleaseId": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*\\.[0-9]+$"
    },
    "review": { "$ref": "common.schema.json#/$defs/review" },
    "legacyParityCases": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/legacyParityCase" }
    },
    "algorithmCases": {
      "type": "array",
      "minItems": 12,
      "items": { "$ref": "#/$defs/algorithmCase" }
    },
    "leapYearCases": {
      "type": "array",
      "minItems": 4,
      "items": { "$ref": "#/$defs/leapYearCase" }
    },
    "overrideCases": {
      "type": "array",
      "minItems": 3,
      "items": { "$ref": "#/$defs/overrideCase" }
    },
    "failureCases": {
      "type": "array",
      "minItems": 7,
      "items": { "$ref": "#/$defs/failureCase" }
    }
  },
  "$defs": {
    "caseId": {
      "type": "string",
      "pattern": "^CAL-[A-Z0-9-]+$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9][a-zA-Z0-9._/-]*\\.json$"
    },
    "legacyParityCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "calendarId",
        "candidateArtifact",
        "referenceArtifact",
        "window",
        "compareFields",
        "expectedCounts"
      ],
      "properties": {
        "caseId": { "$ref": "#/$defs/caseId" },
        "calendarId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "candidateArtifact": { "$ref": "#/$defs/relativePath" },
        "referenceArtifact": { "$ref": "#/$defs/relativePath" },
        "window": { "$ref": "common.schema.json#/$defs/coverage" },
        "compareFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "holidayId",
              "date",
              "kind",
              "labelKey",
              "legalEffect",
              "sourceRefs",
              "periodId",
              "startsOn",
              "endsOn",
              "inclusive",
              "applicableProfileIds"
            ]
          }
        },
        "expectedCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["holidays", "suspensionPeriods"],
          "properties": {
            "holidays": { "type": "integer", "minimum": 0 },
            "suspensionPeriods": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "algorithmCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "year", "calculation", "expected"],
      "properties": {
        "caseId": { "$ref": "#/$defs/caseId" },
        "year": { "type": "integer", "minimum": 1583, "maximum": 9999 },
        "calculation": {
          "oneOf": [
            { "$ref": "calendar-rules-v2.schema.json#/$defs/fixedMonthDay" },
            { "$ref": "calendar-rules-v2.schema.json#/$defs/easterOffsetDays" },
            { "$ref": "calendar-rules-v2.schema.json#/$defs/nthWeekdayOfMonth" },
            { "$ref": "calendar-rules-v2.schema.json#/$defs/relativePeriod" }
          ]
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["date"],
              "properties": {
                "date": { "$ref": "common.schema.json#/$defs/isoDate" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["startsOn", "endsOn"],
              "properties": {
                "startsOn": { "$ref": "common.schema.json#/$defs/isoDate" },
                "endsOn": { "$ref": "common.schema.json#/$defs/isoDate" }
              }
            }
          ]
        }
      }
    },
    "leapYearCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "year", "expectedLeapYear"],
      "properties": {
        "caseId": { "$ref": "#/$defs/caseId" },
        "year": { "type": "integer", "minimum": 1583, "maximum": 9999 },
        "expectedLeapYear": { "type": "boolean" }
      }
    },
    "overrideCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "operation",
        "baseRuleId",
        "baseDate",
        "overrideRuleId",
        "overrideDate",
        "expectedDates",
        "expectedAppliedRuleIds"
      ],
      "properties": {
        "caseId": { "$ref": "#/$defs/caseId" },
        "operation": { "enum": ["add", "suppress", "replace"] },
        "baseRuleId": {
          "type": "string",
          "pattern": "^[A-Z]{2}-CAL-[A-Z0-9-]+$"
        },
        "baseDate": { "$ref": "common.schema.json#/$defs/isoDate" },
        "overrideRuleId": {
          "type": "string",
          "pattern": "^[A-Z]{2}-CAL-[A-Z0-9-]+$"
        },
        "overrideDate": { "$ref": "common.schema.json#/$defs/isoDate" },
        "expectedDates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/isoDate" }
        },
        "expectedAppliedRuleIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]{2}-CAL-[A-Z0-9-]+$"
          }
        }
      }
    },
    "failureCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "failureType", "expectedReasonKey"],
      "properties": {
        "caseId": { "$ref": "#/$defs/caseId" },
        "failureType": {
          "enum": [
            "unknownRuleType",
            "invalidFixedDate",
            "duplicateRuleId",
            "inheritanceCycle",
            "unmatchedOverride",
            "priorityConflict",
            "outsideValidity"
          ]
        },
        "expectedReasonKey": {
          "type": "string",
          "pattern": "^calendar\\.[a-z][a-zA-Z0-9]+$"
        }
      }
    }
  }
}
