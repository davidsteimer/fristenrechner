{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/davidsteimer/fristenrechner/main/schemas/release-manifest.schema.json",
  "title": "Datenrelease-Manifest des Fristenrechners Schweiz",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "formatVersion",
    "dataKind",
    "releaseId",
    "releaseStatus",
    "createdOn",
    "immutable",
    "coverage",
    "profileIds",
    "calendarIds",
    "sourceSummary",
    "providerContract",
    "compatibility",
    "checksumAlgorithm",
    "artifacts"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/davidsteimer/fristenrechner/main/schemas/release-manifest.schema.json"
    },
    "formatVersion": {
      "enum": ["1.0.0", "2.0.0"]
    },
    "dataKind": {
      "const": "releaseManifest"
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*\\.[0-9]+$"
    },
    "releaseStatus": {
      "type": "string",
      "enum": ["draft", "candidate", "approved", "withdrawn"]
    },
    "createdOn": {
      "$ref": "common.schema.json#/$defs/isoDate"
    },
    "immutable": {
      "const": true
    },
    "coverage": {
      "$ref": "common.schema.json#/$defs/coverage"
    },
    "profileIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "calendarIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "specialRegimeCatalogIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "sourceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latestReviewedOn",
        "legalBasisReviewStatus",
        "technicalValidationStatus",
        "sourceIds"
      ],
      "properties": {
        "latestReviewedOn": {
          "$ref": "common.schema.json#/$defs/isoDate"
        },
        "legalBasisReviewStatus": {
          "const": "verified"
        },
        "technicalValidationStatus": {
          "const": "passed"
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(SRC|JUD)-[A-Z0-9-]+$"
          }
        }
      }
    },
    "providerContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pathMode", "byteIdentityRequired", "supportedProviders", "networkFallback"],
      "properties": {
        "pathMode": { "const": "manifestRelative" },
        "byteIdentityRequired": { "const": true },
        "supportedProviders": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["github", "sharepointMirror", "manualImport"]
          },
          "contains": { "const": "github" },
          "allOf": [
            { "contains": { "const": "sharepointMirror" } },
            { "contains": { "const": "manualImport" } }
          ]
        },
        "networkFallback": { "const": "lastVerifiedRelease" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumConsumerFormatVersion",
        "unknownMajorVersionHandling",
        "unknownCoreFieldHandling",
        "extensionsHandling"
      ],
      "properties": {
        "minimumConsumerFormatVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "unknownMajorVersionHandling": { "const": "reject" },
        "unknownCoreFieldHandling": { "const": "reject" },
        "extensionsHandling": { "const": "ignoreNamespaced" }
      }
    },
    "checksumAlgorithm": {
      "const": "sha256"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "formatVersion": { "const": "2.0.0" } },
        "required": ["formatVersion"]
      },
      "then": {
        "required": ["specialRegimeCatalogIds"],
        "properties": {
          "artifacts": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": ["role"],
              "properties": { "role": { "const": "specialRegimeCatalog" } }
            }
          }
        }
      },
      "else": {
        "not": { "required": ["specialRegimeCatalogIds"] }
      }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "contentId",
        "mediaType",
        "schemaId",
        "byteLength",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]*\\.json$"
        },
        "role": {
          "type": "string",
          "enum": ["legalProfile", "calendar", "specialRegimeCatalog"]
        },
        "contentId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "mediaType": {
          "const": "application/json"
        },
        "schemaId": {
          "type": "string",
          "enum": [
            "https://raw.githubusercontent.com/davidsteimer/fristenrechner/main/schemas/legal-profile.schema.json",
            "https://raw.githubusercontent.com/davidsteimer/fristenrechner/main/schemas/calendar.schema.json",
            "https://raw.githubusercontent.com/davidsteimer/fristenrechner/main/schemas/special-regime-catalog-v2.schema.json"
          ]
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
