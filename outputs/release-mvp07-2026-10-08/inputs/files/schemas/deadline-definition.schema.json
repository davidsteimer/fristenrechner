{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/davidsteimer/fristenrechner/main/schemas/deadline-definition.schema.json",
  "title": "Fristdefinition für besondere Fristen",
  "$ref": "#/$defs/deadlineDefinition",
  "$defs": {
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputId", "role", "valueType", "labelKey"],
      "properties": {
        "inputId": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "role": {
          "type": "string",
          "enum": ["trigger", "longstop", "comparison", "authoritativeDeadline"]
        },
        "valueType": {
          "type": "string",
          "enum": ["date", "localTime"]
        },
        "labelKey": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*(?:\\.[a-zA-Z0-9_-]+)+$"
        },
        "fixedMonthDay": {
          "type": "string",
          "pattern": "^(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"
        }
      }
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "unit": {
          "type": "string",
          "enum": ["day", "month"]
        }
      }
    },
    "relativeCalculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "anchorInputId", "direction", "anchorBoundary"],
      "properties": {
        "type": { "const": "R1_RELATIVE" },
        "anchorInputId": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "direction": {
          "type": "string",
          "enum": ["after", "before"]
        },
        "anchorBoundary": {
          "type": "string",
          "enum": ["included", "excluded"]
        },
        "duration": { "$ref": "#/$defs/duration" },
        "durationInputId": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        }
      },
      "oneOf": [
        {
          "required": ["duration"],
          "not": { "required": ["durationInputId"] }
        },
        {
          "required": ["durationInputId"],
          "not": { "required": ["duration"] }
        }
      ]
    },
    "offsetCalculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "anchorInputId", "offsetDays"],
      "properties": {
        "type": { "const": "R2_OFFSET" },
        "anchorInputId": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "offsetDays": {
          "type": "integer",
          "minimum": -366,
          "maximum": 366,
          "not": { "const": 0 }
        }
      }
    },
    "weekdayCalculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "anchorInputId", "weekday", "direction", "ordinal", "strict"],
      "properties": {
        "type": { "const": "R3_WEEKDAY" },
        "anchorInputId": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "weekday": {
          "type": "string",
          "enum": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
        },
        "direction": {
          "type": "string",
          "enum": ["after", "before"]
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "strict": { "type": "boolean" }
      }
    },
    "dualBranch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branchId", "anchorInputId", "anchorBoundary", "duration"],
      "properties": {
        "branchId": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "anchorInputId": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "anchorBoundary": {
          "type": "string",
          "enum": ["included", "excluded"]
        },
        "duration": { "$ref": "#/$defs/duration" }
      }
    },
    "dualCalculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "branches", "selection"],
      "properties": {
        "type": { "const": "R4_DUAL" },
        "branches": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/dualBranch" }
        },
        "selection": {
          "type": "string",
          "enum": ["earliest", "latest"]
        }
      }
    },
    "calculation": {
      "oneOf": [
        { "$ref": "#/$defs/relativeCalculation" },
        { "$ref": "#/$defs/offsetCalculation" },
        { "$ref": "#/$defs/weekdayCalculation" },
        { "$ref": "#/$defs/dualCalculation" }
      ]
    },
    "resultPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calendarProfileId", "suspensionProfileId", "endShiftPolicy", "strictFixedDate"],
      "properties": {
        "calendarProfileId": {
          "type": "string",
          "pattern": "^C_[A-Z0-9_]+$"
        },
        "suspensionProfileId": {
          "type": "string",
          "pattern": "^S[0-9]?_[A-Z0-9_]+$"
        },
        "endShiftPolicy": {
          "type": "string",
          "enum": ["nextWorkingDay", "noShift", "manualReview"]
        },
        "strictFixedDate": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "strictFixedDate": { "const": true } },
            "required": ["strictFixedDate"]
          },
          "then": {
            "properties": { "endShiftPolicy": { "const": "manualReview" } }
          }
        }
      ]
    },
    "authoritativeDeadline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dateValueId", "sourceMode", "sourceRequired"],
      "properties": {
        "dateValueId": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "timeValueId": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "sourceMode": { "const": "caseSpecificOfficialAct" },
        "sourceRequired": { "const": true }
      }
    },
    "base": {
      "type": "object",
      "required": [
        "deadlineDefinitionId",
        "deadlineOrigin",
        "status",
        "validity",
        "anchors",
        "filingProfileId",
        "gateIds",
        "legalOverrideIds",
        "sourceRefs"
      ],
      "properties": {
        "deadlineDefinitionId": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+-[0-9]{3}$"
        },
        "deadlineOrigin": {
          "type": "string",
          "enum": ["CALCULATED", "AUTHORITATIVE"]
        },
        "status": {
          "type": "string",
          "enum": ["supported", "blocked", "open"]
        },
        "validity": { "$ref": "common.schema.json#/$defs/validity" },
        "anchors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/anchor" }
        },
        "filingProfileId": {
          "type": "string",
          "pattern": "^F[0-9]+_[A-Z0-9_]+$"
        },
        "gateIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^G[0-9]+_[A-Z0-9_]+$"
          }
        },
        "legalOverrideIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^OVR-[A-Z0-9-]+$"
          }
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/sourceReference" }
        }
      }
    },
    "calculatedDeadlineDefinition": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deadlineDefinitionId",
            "deadlineOrigin",
            "status",
            "validity",
            "anchors",
            "calculation",
            "resultPolicy",
            "filingProfileId",
            "gateIds",
            "legalOverrideIds",
            "sourceRefs"
          ],
          "properties": {
            "deadlineDefinitionId": true,
            "deadlineOrigin": { "const": "CALCULATED" },
            "status": true,
            "validity": true,
            "anchors": true,
            "calculation": { "$ref": "#/$defs/calculation" },
            "resultPolicy": { "$ref": "#/$defs/resultPolicy" },
            "filingProfileId": true,
            "gateIds": true,
            "legalOverrideIds": true,
            "sourceRefs": true
          }
        }
      ]
    },
    "authoritativeDeadlineDefinition": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deadlineDefinitionId",
            "deadlineOrigin",
            "status",
            "validity",
            "anchors",
            "authoritativeDeadline",
            "filingProfileId",
            "gateIds",
            "legalOverrideIds",
            "sourceRefs"
          ],
          "properties": {
            "deadlineDefinitionId": true,
            "deadlineOrigin": { "const": "AUTHORITATIVE" },
            "status": true,
            "validity": true,
            "anchors": true,
            "authoritativeDeadline": { "$ref": "#/$defs/authoritativeDeadline" },
            "filingProfileId": true,
            "gateIds": true,
            "legalOverrideIds": true,
            "sourceRefs": true
          }
        }
      ]
    },
    "deadlineDefinition": {
      "oneOf": [
        { "$ref": "#/$defs/calculatedDeadlineDefinition" },
        { "$ref": "#/$defs/authoritativeDeadlineDefinition" }
      ]
    }
  }
}
