{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/davidsteimer/fristenrechner/main/schemas/special-regime-catalog-v3.schema.json",
  "title": "Kandidatenvertrag AP17C: Spezialregime mit verbindlicher Anwendbarkeit, Format 3",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "formatVersion", "dataKind", "catalogId", "profileId", "jurisdiction", "validity", "review", "scope", "sources", "calendarProfiles", "suspensionProfiles", "filingProfiles", "gates", "legalOverrides", "deadlineDefinitions", "regimes", "blockedMappings"],
  "properties": {
    "$schema": { "const": "https://raw.githubusercontent.com/davidsteimer/fristenrechner/main/schemas/special-regime-catalog-v3.schema.json" },
    "formatVersion": { "const": "3.0.0" },
    "dataKind": { "const": "specialRegimeCatalog" },
    "catalogId": { "$ref": "special-regime-catalog-v2.schema.json#/properties/catalogId" },
    "profileId": { "const": "vrpg-be" },
    "jurisdiction": { "$ref": "common.schema.json#/$defs/jurisdiction" },
    "validity": { "$ref": "common.schema.json#/$defs/validity" },
    "review": { "$ref": "common.schema.json#/$defs/review" },
    "scope": { "$ref": "special-regime-catalog-v2.schema.json#/$defs/labels" },
    "sources": { "$ref": "special-regime-catalog-v2.schema.json#/properties/sources" },
    "calendarProfiles": { "$ref": "special-regime-catalog-v2.schema.json#/properties/calendarProfiles" },
    "suspensionProfiles": { "$ref": "special-regime-catalog-v2.schema.json#/properties/suspensionProfiles" },
    "filingProfiles": { "$ref": "special-regime-catalog-v2.schema.json#/properties/filingProfiles" },
    "gates": { "$ref": "special-regime-catalog-v2.schema.json#/properties/gates" },
    "legalOverrides": { "$ref": "special-regime-catalog-v2.schema.json#/properties/legalOverrides" },
    "regimes": { "$ref": "special-regime-catalog-v2.schema.json#/properties/regimes" },
    "blockedMappings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["mappingId", "sourceRefs"],
        "properties": {
          "mappingId": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
          "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/sourceReference" } }
        }
      }
    },
    "deadlineDefinitions": {
      "type": "array", "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/calculatedDeadlineDefinition" },
          { "$ref": "deadline-definition.schema.json#/$defs/authoritativeDeadlineDefinition" }
        ]
      }
    }
  },
  "$defs": {
    "applicability": {
      "type": "object", "additionalProperties": false,
      "required": ["mappingId", "selection", "authorityCode", "matter", "deadlineForm", "triggerKind", "holidayCanton", "holidayPolicy", "notificationChannels", "procedureStartOnOrAfter", "caseCoverageFrom", "caseCoverageTo", "sourceRefs"],
      "properties": {
        "mappingId": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]+$" },
        "selection": {
          "type": "object", "additionalProperties": false, "required": ["area", "law", "action", "stage"],
          "properties": {
            "area": { "enum": ["social", "procurement"] },
            "law": { "enum": ["ivg", "ahvg", "uvg", "ivob"] },
            "action": { "type": "string", "minLength": 1 },
            "stage": { "type": "string" }
          }
        },
        "authorityCode": { "const": "BE" },
        "matter": { "type": "string", "minLength": 1 },
        "deadlineForm": { "const": "days" },
        "triggerKind": { "type": "string", "minLength": 1 },
        "holidayCanton": { "const": "BE" },
        "holidayPolicy": { "enum": ["partyOrRepresentative", "bern"] },
        "notificationChannels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["individual-service", "official-publication"] } },
        "procedureStartOnOrAfter": { "type": ["string", "null"], "format": "date" },
        "caseCoverageFrom": { "type": "string", "format": "date" },
        "caseCoverageTo": { "type": ["string", "null"], "format": "date" },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/sourceReference" } }
      }
    },
    "calculatedDeadlineDefinition": {
      "allOf": [
        { "$ref": "deadline-definition.schema.json#/$defs/base" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["deadlineDefinitionId", "deadlineOrigin", "status", "validity", "anchors", "calculation", "resultPolicy", "filingProfileId", "gateIds", "legalOverrideIds", "sourceRefs", "applicability"],
          "properties": {
            "deadlineDefinitionId": true,
            "deadlineOrigin": { "const": "CALCULATED" },
            "status": true,
            "validity": true,
            "anchors": true,
            "calculation": { "$ref": "deadline-definition.schema.json#/$defs/calculation" },
            "resultPolicy": { "$ref": "deadline-definition.schema.json#/$defs/resultPolicy" },
            "filingProfileId": true,
            "gateIds": true,
            "legalOverrideIds": true,
            "sourceRefs": true,
            "applicability": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/applicability" }] }
          },
          "allOf": [{
            "if": { "properties": { "deadlineDefinitionId": { "type": "string", "pattern": "^AP17C-" } }, "required": ["deadlineDefinitionId"] },
            "then": { "properties": { "applicability": { "$ref": "#/$defs/applicability" } } },
            "else": { "properties": { "applicability": { "type": "null" } } }
          }]
        }
      ]
    }
  }
}
