{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/davidsteimer/fristenrechner/main/schemas/calendar.schema.json",
  "title": "Feiertags- und Stillstandskalender des Fristenrechners Schweiz",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "formatVersion",
    "dataKind",
    "calendarId",
    "jurisdiction",
    "coverage",
    "inherits",
    "review",
    "sources",
    "holidays",
    "suspensionSets"
  ],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/davidsteimer/fristenrechner/main/schemas/calendar.schema.json"
    },
    "formatVersion": {
      "const": "1.0.0"
    },
    "dataKind": {
      "const": "calendar"
    },
    "calendarId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "jurisdiction": {
      "$ref": "common.schema.json#/$defs/jurisdiction"
    },
    "coverage": {
      "$ref": "common.schema.json#/$defs/coverage"
    },
    "inherits": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "review": {
      "$ref": "common.schema.json#/$defs/review"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/source"
      }
    },
    "holidays": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/holiday"
      }
    },
    "suspensionSets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/suspensionSet"
      }
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "$defs": {
    "holiday": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holidayId", "date", "kind", "labelKey", "legalEffect", "sourceRefs"],
      "properties": {
        "holidayId": {
          "type": "string",
          "pattern": "^[A-Z]{2}-[0-9]{4}-[0-9]{2}-[0-9]{2}-[A-Z0-9-]+$"
        },
        "date": {
          "$ref": "common.schema.json#/$defs/isoDate"
        },
        "kind": {
          "type": "string",
          "enum": ["federalHoliday", "cantonalPublicHoliday"]
        },
        "labelKey": {
          "type": "string",
          "pattern": "^holiday\\.[a-z][a-zA-Z0-9]*(?:\\.[a-zA-Z0-9_-]+)+$"
        },
        "legalEffect": {
          "const": "nonWorkingDayEquivalentToSunday"
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/sourceReference"
          }
        }
      }
    },
    "suspensionSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suspensionSetId", "applicableProfileIds", "sourceRefs", "periods"],
      "properties": {
        "suspensionSetId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "applicableProfileIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/sourceReference"
          }
        },
        "periods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/suspensionPeriod"
          }
        }
      }
    },
    "suspensionPeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodId", "startsOn", "endsOn", "inclusive", "labelKey"],
      "properties": {
        "periodId": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+$"
        },
        "startsOn": {
          "$ref": "common.schema.json#/$defs/isoDate"
        },
        "endsOn": {
          "$ref": "common.schema.json#/$defs/isoDate"
        },
        "inclusive": {
          "const": true
        },
        "labelKey": {
          "type": "string",
          "pattern": "^suspension\\.[a-z][a-zA-Z0-9]*(?:\\.[a-zA-Z0-9_-]+)+$"
        }
      }
    }
  }
}
