  "boundaries": [
    {"id":"GE-B-SPECIAL","status":"qualificationBoundaryProposed","reason":"Unknown or differing federal/cantonal special procedure, absent enabling reclamation or authority outside cantonal scope prevents a positive J1 standard result."},
    {"id":"GE-B-63EXCEPTIONS","status":"qualificationBoundaryProposed","reason":"Six Art. 63(2) categories must be assessed separately. Exception means no ordinary holiday pause but does not itself verify the special duration or trigger.","categories":["votationsAndElections","publicProcurement","specifiedForeignNationalDetentionTerritorialAssignmentProhibitionRetention","domesticViolence","LPFiscProcedures","removalConseilEtatMemberForDurableIncapacity"]},
    {"id":"GE-B-OPENING","status":"qualificationBoundaryProposed","reason":"Unknown normal-post status, fiction reconstructed from first attempted delivery, oral opening without qualified written confirmation, publication or faultless actual-knowledge case Art. 62(5) is not ordinary day-after-qualified-opening input."},
    {"id":"GE-B-NOTICE","status":"qualificationBoundaryProposed","reason":"Art. 62(2) longer erroneous notice and Art. 47 irregular notification legally matter. Initial positive paths require no unresolved departure. No free day-count override pretending that qualifying facts or protection conditions exist."},
    {"id":"GE-B-ENDSHIFT","status":"unresolvedBoundaryProposed","reason":"Last counted non-suspended day falls on weekend/holiday and pure end shift would enter newly started recess. Current research does not settle this collision for GE. Block only concrete collision, not all cases around recess."},
    {"id":"GE-B-ENFORCEMENT","status":"qualificationBoundaryProposed","reason":"Enforcement measures excluded by Art. 59(b), not automatically an Art. 62(1)(b) ten-day decision."},
    {"id":"GE-B-PAYMENT","status":"qualificationBoundaryProposed","reason":"Payment, cost advance, fixed appointment, backwards duration and hour/week/month/year unit are outside forward-day submission calculator."},
    {"id":"GE-B-ELECTRONIC","status":"documentedBoundary","reason":"Art. 18A(6), reinforced by ATA/520/2026 E. 2.6, excludes electronic communication in appeal proceedings Arts. 57–89. Result does not certify admissibility of email filing. Legally established electronic opening can only be used as qualified date after outside legal verification."}
  ],
  "exclusions": [
    {"id":"GE-X-ORAL5","provision":"Art. 46(3)","classification":"separate-trigger-chain-researched-excluded-from-initial-positive-paths","reason":"Five-day request for written confirmation of an oral decision occurs in the notifying procedure. Its own suspension qualification cannot be inferred solely from later appeal stage. Preserve the rule in background, do not calculate later appeal from oral date. Once confirmation is positively established, applicable ordinary remedy can use its own legal opening."},
    {"id":"GE-X-RESTORE10","provision":"Art. 16(3)","classification":"restitution-special-trigger","reason":"Ten-day motivated restoration request from end of faultless impediment, not an ordinary receipt-triggered standard submission. Force majeure and judicial assessment not automatically reconstructed."},
    {"id":"GE-X-RECONSIDER","provision":"Art. 48(2)","classification":"no-general-fixed-day-reconsideration","reason":"No automatic interruption or suspensive effect. Does not restart an ordinary appeal period."},
    {"id":"GE-X-REVISION","provision":"Arts. 80–81","classification":"month-year-deadlines-and-special-facts","reason":"Three months from discovery and outer ten years are not forward-day input."},
    {"id":"GE-X-INTERPRETATION","provision":"Art. 84(2–3)","classification":"special-action-and-follow-on-opening","reason":"References Art. 62 duration but interpretation request and new period after interpretation need separate legal action/trigger qualification. Not silently released as ordinary appeal."},
    {"id":"GE-X-WITNESS","provision":"Art. 30","classification":"special-witness-action","reason":"Immediate audience opposition or thirty days after notification in ended inquiry is outside ordinary party procedural paths."},
    {"id":"GE-X-RECUSAL","provision":"Arts. 15(3), 15A(4), 15B(1)","classification":"immediate-or-knowledge-trigger","reason":"Without-delay request and five-day demand for annulment of affected acts use special knowledge facts, not ordinary service input."},
    {"id":"GE-X-POLITICAL-NORM","provision":"Art. 62(1)(c–d), 62(3)","classification":"special-subject-and-publication-trigger","reason":"Six-day political remedy and thirty-day abstract norm challenge not general appeal against a served individual decision."},
